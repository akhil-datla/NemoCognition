# --- NemoClaw CLI / recorder ---
# NVIDIA NIM API key (required for `nemoclaw-record record`)
NIM_API_KEY=nvapi-replace-me

# NIM gateway (default: NVIDIA-hosted)
NIM_ENDPOINT=https://integrate.api.nvidia.com/v1

# Nemotron model identifier on NIM
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Arize Phoenix HTTP endpoint (OTLP/HTTP; port 6006 by default in the docker image)
PHOENIX_ENDPOINT=http://localhost:6006

# NemoCognition web app — the recorder POSTs the session to /api/runs/import
# Leave unset to skip the import (Phoenix-only mode)
NEMOCOGNITION_API_URL=http://localhost:3000

# --- NemoCognition web app (Next.js) ---
# Postgres connection (Drizzle) — only used when the API switches off InMemoryStore
DATABASE_URL=postgres://nemocognition:nemocognition@localhost:5432/nemocognition

# Redis (for the future video-rendering worker queue)
REDIS_URL=redis://localhost:6379
