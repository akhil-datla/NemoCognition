{
  "name": "@nemocognition/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "nemoclaw-record": "./dist/bin.js"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsup src/bin.ts --format esm --dts --outDir dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "tar": "^7.5.21",
    "@nemocognition/core": "workspace:*",
    "@nemocognition/tracing": "workspace:*",
    "@nemocognition/nemoclaw": "workspace:*",
    "@nemocognition/recovery": "workspace:*"
  },
  "devDependencies": {
    "@types/tar": "^7.0.87",
    "tsx": "^4.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
