# syntax=docker/dockerfile:1.7

# ---- deps ----
FROM node:20-alpine AS deps
WORKDIR /workspace
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

# Copy lockfile + manifests first for layer caching.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/tracing/package.json packages/tracing/
COPY packages/nemoclaw/package.json packages/nemoclaw/
COPY packages/db/package.json packages/db/
COPY packages/recovery/package.json packages/recovery/
COPY packages/video/package.json packages/video/
COPY packages/cli/package.json packages/cli/

RUN pnpm install --frozen-lockfile

# ---- builder ----
FROM node:20-alpine AS builder
WORKDIR /workspace
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
COPY --from=deps /workspace ./
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
# Tracing root must point at the monorepo root so Next picks up workspace deps.
ENV NEXT_OUTPUT_FILE_TRACING_ROOT=/workspace
RUN pnpm --filter @nemocognition/web build

# ---- runtime ----
FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat wget
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Next standalone output emits server.js at the *traced root* + the app path.
# With tracing root = /workspace, server.js lands at /workspace/apps/web/server.js.
COPY --from=builder --chown=node:node /workspace/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /workspace/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000
USER node
CMD ["node", "apps/web/server.js"]
